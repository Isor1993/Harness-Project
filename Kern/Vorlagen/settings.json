{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/Kern/Werkzeuge/pruefen.py",
              "--hook"
            ],
            "timeout": 60,
            "statusMessage": "pruefen.py laeuft ..."
          }
        ]
      }
    ]
  }
}
